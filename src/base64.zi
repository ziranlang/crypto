// Fast canonical RFC 4648 Base64 and Base64url encoder/decoder.
// Uses a 256-entry decode table and rejects non-canonical trailing bits.
#scope_file
STD_ALPHABET :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
URL_ALPHABET :: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"

// Build decode value for one byte (standard or url-safe).
DecodeTable :: (url_safe: bool) -> [256]s8 {
    table: [256]s8
    for i: 0..255 { table[i] = -1 }
    for i: 0..25 { table[65 + i] = cast(s8)i }
    for i: 0..25 { table[97 + i] = cast(s8)(26 + i) }
    for i: 0..9 { table[48 + i] = cast(s8)(52 + i) }
    if url_safe {
        table[45] = 62 // '-'
        table[95] = 63 // '_'
    } else {
        table[43] = 62 // '+'
        table[47] = 63 // '/'
    }
    return table
}

#scope_export
EncodedSize :: (input_len: s64, padded: bool) -> s64 {
    if input_len < 0 { return -1 }
    if padded {
        return ((input_len + 2) / 3) * 4
    }
    rem := input_len % 3
    return (input_len / 3) * 4 + (ifx rem == 0 then cast(s64)0 else rem + 1)
}

DecodedSize :: (encoded_len: s64) -> s64 {
    if encoded_len < 0 || encoded_len % 4 == 1 { return -1 }
    rem := encoded_len % 4
    return (encoded_len / 4) * 3 + (ifx rem == 0 then cast(s64)0 else rem - 1)
}

Encode :: (input: []u8, output: []u8, url_safe: bool = true, padded: bool = false) -> s64 {
    needed := EncodedSize(input.count, padded)
    if needed < 0 || needed > output.count { return -1 }
    alphabet := ifx url_safe then URL_ALPHABET else STD_ALPHABET
    i: s64 = 0
    o: s64 = 0
    while i + 3 <= input.count {
        v := (cast(u32)input[i] << 16) | (cast(u32)input[i + 1] << 8) | cast(u32)input[i + 2]
        output[o] = alphabet[cast(s64)((v >> 18) & 63)]
        output[o + 1] = alphabet[cast(s64)((v >> 12) & 63)]
        output[o + 2] = alphabet[cast(s64)((v >> 6) & 63)]
        output[o + 3] = alphabet[cast(s64)(v & 63)]
        i += 3
        o += 4
    }
    rem := input.count - i
    if rem == 1 {
        v := cast(u32)input[i] << 16
        output[o] = alphabet[cast(s64)((v >> 18) & 63)]
        output[o + 1] = alphabet[cast(s64)((v >> 12) & 63)]
        o += 2
        if padded {
            output[o] = 61
            output[o + 1] = 61
            o += 2
        }
    } else if rem == 2 {
        v := (cast(u32)input[i] << 16) | (cast(u32)input[i + 1] << 8)
        output[o] = alphabet[cast(s64)((v >> 18) & 63)]
        output[o + 1] = alphabet[cast(s64)((v >> 12) & 63)]
        output[o + 2] = alphabet[cast(s64)((v >> 6) & 63)]
        o += 3
        if padded {
            output[o] = 61
            o += 1
        }
    }
    return o
}

Decode :: (text: string, output: []u8, url_safe: bool = true, allow_padding: bool = false) -> s64 {
    len := text.count
    if allow_padding && len > 0 {
        if len % 4 != 0 { return -1 }
        if text[len - 1] == 61 { len -= 1 }
        if len > 0 && text[len - 1] == 61 { len -= 1 }
    }
    needed := DecodedSize(len)
    if needed < 0 || needed > output.count { return -1 }
    table := DecodeTable(url_safe)
    value: u32 = 0
    bits: s32 = 0
    out_len: s64 = 0
    for idx: cast(s64)0..len - 1 {
        digit := cast(s32)table[cast(s64)text[idx]]
        if digit < 0 { return -1 }
        value = (value << 6) | cast(u32)digit
        bits += 6
        if bits >= 8 {
            bits -= 8
            output[out_len] = cast(u8)((value >> cast(u32)bits) & 255)
            out_len += 1
        }
    }
    if bits > 0 && (value & ((cast(u32)1 << cast(u32)bits) - 1)) != 0 { return -1 }
    return out_len
}
