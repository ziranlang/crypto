// Key derivation functions: PBKDF2-HMAC-SHA-256 (with precomputed HMAC
// midstates, no silent salt truncation) and RFC 5869 HKDF-SHA-256.
// Portable Ziran; wipes intermediate secrets before returning.
Hash :: #import "sha256";
Wipe :: #import "wipe";

#scope_export
// PBKDF2-HMAC-SHA-256 with arbitrary salt length (up to 1024 bytes) and
// arbitrary output length (up to 1024 bytes). Uses precomputed HMAC-SHA-256
// ipad/opad midstates (~2x faster than recomputing the key block per round).
Pbkdf2Sha256 :: (password: []u8, salt: []u8, iterations: u64, output: []u8) -> bool {
    if salt.count < 0 || salt.count > 1024 || output.count <= 0 || output.count > 1024 ||
        iterations == 0 || iterations > 100000000 {
        return false
    }
    state: Hash.HmacSha256State
    defer Hash.HmacSha256Wipe(*state)
    if password.count > 0 {
        Hash.HmacSha256Prepare(*state, *password[0], password.count)
    } else {
        empty: [1]u8
        Hash.HmacSha256Prepare(*state, *empty[0], 0)
    }
    input: [1028]u8
    u: [32]u8
    t: [32]u8
    defer {
        Wipe.SecureWipe(input[:])
        Wipe.SecureWipe(u[:])
        Wipe.SecureWipe(t[:])
    }
    for index: cast(s64)0..salt.count - 1 {
        input[index] = salt[index]
    }
    block: u32 = 1
    at: s64 = 0
    while at < output.count {
        input[salt.count] = cast(u8)(block >> 24)
        input[salt.count + 1] = cast(u8)(block >> 16)
        input[salt.count + 2] = cast(u8)(block >> 8)
        input[salt.count + 3] = cast(u8)block
        Hash.HmacSha256Compute(*state, *input[0], salt.count + 4, *u[0])
        for index: 0..31 { t[index] = u[index] }
        round: u64 = 1
        while round < iterations {
            Hash.HmacSha256Compute(*state, *u[0], 32, *u[0])
            for index: 0..31 { t[index] ^= u[index] }
            round += 1
        }
        for index: 0..31 {
            if at < output.count {
                output[at] = t[index]
                at += 1
            }
        }
        block += 1
    }
    return true
}

// Pointer form of PBKDF2-HMAC-SHA-256 producing one 32-byte key.
// Supports salts up to 1024 bytes without silent truncation.
Pbkdf2Sha256Pointer :: (password: *u8, password_length: s64,
    salt: *u8, salt_length: s64, iterations: u64, output: *u8) -> s32 {
    if output == null || iterations == 0 || iterations > 100000000 ||
        password_length < 0 || salt_length < 0 || salt_length > 1024 ||
        (password == null && password_length > 0) ||
        (salt == null && salt_length > 0) {
        return 0
    }
    state: Hash.HmacSha256State
    defer Hash.HmacSha256Wipe(*state)
    Hash.HmacSha256Prepare(*state, password, password_length)
    input: [1028]u8
    u: [32]u8
    t: [32]u8
    defer {
        Wipe.SecureWipe(input[:])
        Wipe.SecureWipe(u[:])
        Wipe.SecureWipe(t[:])
    }
    index: s64 = 0
    while index < salt_length {
        input[index] = salt[index]
        index += 1
    }
    input[salt_length] = 0
    input[salt_length + 1] = 0
    input[salt_length + 2] = 0
    input[salt_length + 3] = 1
    Hash.HmacSha256Compute(*state, *input[0], salt_length + 4, *u[0])
    for i: 0..31 { t[i] = u[i] }
    round: u64 = 1
    while round < iterations {
        Hash.HmacSha256Compute(*state, *u[0], 32, *u[0])
        for i: 0..31 { t[i] ^= u[i] }
        round += 1
    }
    for i: 0..31 { output[i] = t[i] }
    return 1
}

// RFC 5869 HKDF-Extract(salt, IKM) -> PRK (32 bytes).
// An empty salt uses 32 zero bytes as specified by RFC 5869 Section 2.2.
HkdfExtract :: (salt: []u8, ikm: []u8, prk: []u8) -> bool {
    if prk.count != 32 || salt.count < 0 || ikm.count < 0 { return false }
    zeros: [32]u8
    key_ptr := ifx salt.count > 0 then *salt[0] else *zeros[0]
    key_len := ifx salt.count > 0 then salt.count else cast(s64)32
    ikm_ptr := ifx ikm.count > 0 then *ikm[0] else *zeros[0]
    return Hash.HmacSha256(key_ptr, key_len, ikm_ptr, ikm.count, *prk[0]) == 1
}

// RFC 5869 HKDF-Expand(PRK, info, L) -> OKM (up to 255 * 32 = 8160 bytes).
HkdfExpand :: (prk: []u8, info: []u8, okm: []u8) -> bool {
    if prk.count != 32 || info.count < 0 || okm.count <= 0 || okm.count > 255 * 32 {
        return false
    }
    state: Hash.HmacSha256State
    defer Hash.HmacSha256Wipe(*state)
    Hash.HmacSha256Prepare(*state, *prk[0], 32)
    previous: [32]u8
    counter: [1]u8
    defer Wipe.SecureWipe(previous[:])
    produced: s64 = 0
    block: u8 = 1
    while produced < okm.count {
        inner := state.inner
        if block > 1 {
            Hash.Sha256UpdateBytes(*inner, previous[:])
        }
        if info.count > 0 {
            Hash.Sha256UpdateBytes(*inner, info)
        }
        counter[0] = block
        Hash.Sha256UpdateBytes(*inner, counter[:])
        inner_digest: [32]u8
        Hash.Sha256FinishBytes(*inner, inner_digest[:])
        outer := state.outer
        Hash.Sha256UpdateBytes(*outer, inner_digest[:])
        Hash.Sha256FinishBytes(*outer, previous[:])
        Wipe.SecureWipe(inner_digest[:])
        for index: 0..31 {
            if produced < okm.count {
                okm[produced] = previous[index]
                produced += 1
            }
        }
        if block == 255 { break }
        block += 1
    }
    return produced == okm.count
}

// RFC 5869 one-shot HKDF-SHA-256(salt, IKM, info) -> OKM.
HkdfSha256 :: (salt: []u8, ikm: []u8, info: []u8, okm: []u8) -> bool {
    prk: [32]u8
    defer Wipe.SecureWipe(prk[:])
    return HkdfExtract(salt, ikm, prk[:]) && HkdfExpand(prk[:], info, okm)
}
