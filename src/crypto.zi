using Hash :: #import "sha256";
using LegacyHash :: #import "sha1";
using Aes :: #import "aes";
WipeMod :: #import "wipe";
KdfMod :: #import "kdf";

Equal :: (a: []u8, b: []u8) -> bool {
    return WipeMod.ConstantTimeEqual(a, b)
}

Wipe :: (bytes: []u8) {
    WipeMod.SecureWipe(bytes)
}

// Arbitrary salt length and output length; no silent truncation.
Pbkdf2 :: (password: []u8, salt: []u8, iterations: s32, output: []u8) -> bool {
    if iterations <= 0 || iterations > 1000000 { return false }
    return KdfMod.Pbkdf2Sha256(password, salt, cast(u64)iterations, output)
}
