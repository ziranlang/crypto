// RFC 8439 ChaCha20-Poly1305 and draft-irtf-cfrg-xchacha XChaCha20-Poly1305.
// Portable Ziran implementation; wipes temporary keys and keystream blocks.
Wipe :: #import "wipe";

#scope_file
Poly1305State :: struct {
    r: [5]u64
    scaled: [4]u64
    h: [5]u64
}

Load32LE :: (bytes: *u8) -> u32 {
    return cast(u32)bytes[0] |
        (cast(u32)bytes[1] << cast(u32)8) |
        (cast(u32)bytes[2] << cast(u32)16) |
        (cast(u32)bytes[3] << cast(u32)24)
}

Store32LE :: (bytes: *u8, value: u32) {
    bytes[0] = cast(u8)value
    bytes[1] = cast(u8)(value >> cast(u32)8)
    bytes[2] = cast(u8)(value >> cast(u32)16)
    bytes[3] = cast(u8)(value >> cast(u32)24)
}

Poly1305Initialize :: (state: *Poly1305State, key: *u8) {
    state.* = Poly1305State.{}
    state.r[0] = cast(u64)Load32LE(key) & cast(u64)0x3ffffff
    state.r[1] = cast(u64)(Load32LE(*key[3]) >> cast(u32)2) & cast(u64)0x3ffff03
    state.r[2] = cast(u64)(Load32LE(*key[6]) >> cast(u32)4) & cast(u64)0x3ffc0ff
    state.r[3] = cast(u64)(Load32LE(*key[9]) >> cast(u32)6) & cast(u64)0x3f03fff
    state.r[4] = cast(u64)(Load32LE(*key[12]) >> cast(u32)8) & cast(u64)0x00fffff
    state.scaled[0] = state.r[1] * 5
    state.scaled[1] = state.r[2] * 5
    state.scaled[2] = state.r[3] * 5
    state.scaled[3] = state.r[4] * 5
}

Poly1305Block :: (state: *Poly1305State, message: *u8, length: s32) {
    block: [17]u8 = .[0]
    index: s32 = 0
    while index < length {
        block[index] = message[index]
        index += 1
    }
    if length < 16 {
        block[length] = 1
    }

    input: [5]u64
    input[0] = cast(u64)Load32LE(*block[0]) & cast(u64)0x3ffffff
    input[1] = cast(u64)(Load32LE(*block[3]) >> cast(u32)2) & cast(u64)0x3ffffff
    input[2] = cast(u64)(Load32LE(*block[6]) >> cast(u32)4) & cast(u64)0x3ffffff
    input[3] = cast(u64)(Load32LE(*block[9]) >> cast(u32)6) & cast(u64)0x3ffffff
    input[4] = cast(u64)(Load32LE(*block[12]) >> cast(u32)8)
    if length == 16 {
        input[4] |= cast(u64)1 << cast(u64)24
    }

    index = 0
    while index < 5 {
        state.h[index] += input[index]
        index += 1
    }

    d0 := state.h[0] * state.r[0] + state.h[1] * state.scaled[3] +
        state.h[2] * state.scaled[2] + state.h[3] * state.scaled[1] +
        state.h[4] * state.scaled[0]
    d1 := state.h[1] * state.r[0] + state.h[2] * state.scaled[3] +
        state.h[3] * state.scaled[2] + state.h[4] * state.scaled[1] +
        state.h[0] * state.r[1]
    d2 := state.h[2] * state.r[0] + state.h[3] * state.scaled[3] +
        state.h[4] * state.scaled[2] + state.h[0] * state.r[2] +
        state.h[1] * state.r[1]
    d3 := state.h[3] * state.r[0] + state.h[4] * state.scaled[3] +
        state.h[0] * state.r[3] + state.h[1] * state.r[2] +
        state.h[2] * state.r[1]
    d4 := state.h[4] * state.r[0] + state.h[0] * state.r[4] +
        state.h[1] * state.r[3] + state.h[2] * state.r[2] +
        state.h[3] * state.r[1]

    carry := d0 >> cast(u64)26
    state.h[0] = d0 & cast(u64)0x3ffffff
    d1 += carry
    carry = d1 >> cast(u64)26
    state.h[1] = d1 & cast(u64)0x3ffffff
    d2 += carry
    carry = d2 >> cast(u64)26
    state.h[2] = d2 & cast(u64)0x3ffffff
    d3 += carry
    carry = d3 >> cast(u64)26
    state.h[3] = d3 & cast(u64)0x3ffffff
    d4 += carry
    carry = d4 >> cast(u64)26
    state.h[4] = d4 & cast(u64)0x3ffffff
    state.h[0] += carry * 5
    carry = state.h[0] >> cast(u64)26
    state.h[0] &= cast(u64)0x3ffffff
    state.h[1] += carry
}

Poly1305AeadPadded :: (state: *Poly1305State, data: *u8, length: s64) {
    offset: s64 = 0
    while length - offset >= 16 {
        Poly1305Block(state, *data[offset], 16)
        offset += 16
    }
    if offset < length {
        padded: [16]u8 = .[0]
        index: s32 = 0
        while cast(s64)index < length - offset {
            padded[index] = data[offset + cast(s64)index]
            index += 1
        }
        Poly1305Block(state, *padded[0], 16)
    }
}

Poly1305Finish :: (state: *Poly1305State, key: *u8, tag: *u8) {
    carry := state.h[1] >> cast(u64)26
    state.h[1] &= cast(u64)0x3ffffff
    state.h[2] += carry
    carry = state.h[2] >> cast(u64)26
    state.h[2] &= cast(u64)0x3ffffff
    state.h[3] += carry
    carry = state.h[3] >> cast(u64)26
    state.h[3] &= cast(u64)0x3ffffff
    state.h[4] += carry
    carry = state.h[4] >> cast(u64)26
    state.h[4] &= cast(u64)0x3ffffff
    state.h[0] += carry * 5
    carry = state.h[0] >> cast(u64)26
    state.h[0] &= cast(u64)0x3ffffff
    state.h[1] += carry

    reduced: [5]u64
    reduced[0] = state.h[0] + 5
    carry = reduced[0] >> cast(u64)26
    reduced[0] &= cast(u64)0x3ffffff
    reduced[1] = state.h[1] + carry
    carry = reduced[1] >> cast(u64)26
    reduced[1] &= cast(u64)0x3ffffff
    reduced[2] = state.h[2] + carry
    carry = reduced[2] >> cast(u64)26
    reduced[2] &= cast(u64)0x3ffffff
    reduced[3] = state.h[3] + carry
    carry = reduced[3] >> cast(u64)26
    reduced[3] &= cast(u64)0x3ffffff
    reduced[4] = state.h[4] + carry - (cast(u64)1 << cast(u64)26)

    use_reduced := (reduced[4] >> cast(u64)63) - 1
    index: s32 = 0
    while index < 5 {
        state.h[index] = (state.h[index] & ~use_reduced) |
            (reduced[index] & use_reduced)
        index += 1
    }

    low := state.h[0] | (state.h[1] << cast(u64)26) |
        ((state.h[2] & cast(u64)0xfff) << cast(u64)52)
    high := (state.h[2] >> cast(u64)12) |
        (state.h[3] << cast(u64)14) | (state.h[4] << cast(u64)40)

    word := (low & cast(u64)0xffffffff) + cast(u64)Load32LE(*key[16])
    Store32LE(tag, cast(u32)word)
    word = (low >> cast(u64)32) + cast(u64)Load32LE(*key[20]) +
        (word >> cast(u64)32)
    Store32LE(*tag[4], cast(u32)word)
    word = (high & cast(u64)0xffffffff) + cast(u64)Load32LE(*key[24]) +
        (word >> cast(u64)32)
    Store32LE(*tag[8], cast(u32)word)
    word = (high >> cast(u64)32) + cast(u64)Load32LE(*key[28]) +
        (word >> cast(u64)32)
    Store32LE(*tag[12], cast(u32)word)
}

Poly1305AeadTag :: (key: *u8, aad: *u8, aad_length: s64,
    ciphertext: *u8, ciphertext_length: s64, tag: *u8) {
    state: Poly1305State
    Poly1305Initialize(*state, key)
    if aad_length > 0 {
        Poly1305AeadPadded(*state, aad, aad_length)
    }
    if ciphertext_length > 0 {
        Poly1305AeadPadded(*state, ciphertext, ciphertext_length)
    }
    lengths: [16]u8
    Store32LE(*lengths[0], cast(u32)aad_length)
    Store32LE(*lengths[4], cast(u32)(cast(u64)aad_length >> cast(u64)32))
    Store32LE(*lengths[8], cast(u32)ciphertext_length)
    Store32LE(*lengths[12], cast(u32)(cast(u64)ciphertext_length >> cast(u64)32))
    Poly1305Block(*state, *lengths[0], 16)
    Poly1305Finish(*state, key, tag)
    Wipe.SecureWipePointer(cast(*u8)*state, size_of(Poly1305State))
}

ChaChaBlockBytes :: 64
ChaChaTagBytes :: 16

ChaChaLengthValid :: (length: s64) -> bool {
    if length < 0 { return false }
    full_blocks := length / ChaChaBlockBytes
    if full_blocks > cast(s64)4294967295 { return false }
    if full_blocks == cast(s64)4294967295 && length % ChaChaBlockBytes != 0 { return false }
    return true
}

ChaChaRotateLeft :: (value: u32, bits: u32) -> u32 {
    return (value << bits) | (value >> (cast(u32)32 - bits))
}

ChaChaQuarterRound :: (state: *u32, a: s32, b: s32, c: s32, d: s32) {
    state[a] += state[b]
    state[d] ^= state[a]
    state[d] = ChaChaRotateLeft(state[d], 16)
    state[c] += state[d]
    state[b] ^= state[c]
    state[b] = ChaChaRotateLeft(state[b], 12)
    state[a] += state[b]
    state[d] ^= state[a]
    state[d] = ChaChaRotateLeft(state[d], 8)
    state[c] += state[d]
    state[b] ^= state[c]
    state[b] = ChaChaRotateLeft(state[b], 7)
}

ChaChaBlock :: (key: *u8, nonce: *u8, counter: u32, output: *u8) {
    initial: [16]u32
    working: [16]u32
    defer {
        Wipe.SecureWipePointer(cast(*u8)*initial[0], size_of(type_of(initial)))
        Wipe.SecureWipePointer(cast(*u8)*working[0], size_of(type_of(working)))
    }
    initial[0] = 0x61707865
    initial[1] = 0x3320646e
    initial[2] = 0x79622d32
    initial[3] = 0x6b206574
    index: s32 = 0
    while index < 8 {
        initial[4 + index] = Load32LE(*key[index * 4])
        index += 1
    }
    initial[12] = counter
    initial[13] = Load32LE(nonce)
    initial[14] = Load32LE(*nonce[4])
    initial[15] = Load32LE(*nonce[8])
    index = 0
    while index < 16 {
        working[index] = initial[index]
        index += 1
    }

    round: s32 = 0
    while round < 10 {
        ChaChaQuarterRound(*working[0], 0, 4, 8, 12)
        ChaChaQuarterRound(*working[0], 1, 5, 9, 13)
        ChaChaQuarterRound(*working[0], 2, 6, 10, 14)
        ChaChaQuarterRound(*working[0], 3, 7, 11, 15)
        ChaChaQuarterRound(*working[0], 0, 5, 10, 15)
        ChaChaQuarterRound(*working[0], 1, 6, 11, 12)
        ChaChaQuarterRound(*working[0], 2, 7, 8, 13)
        ChaChaQuarterRound(*working[0], 3, 4, 9, 14)
        round += 1
    }
    index = 0
    while index < 16 {
        Store32LE(*output[index * 4], working[index] + initial[index])
        index += 1
    }
}

ChaChaXor :: (key: *u8, nonce: *u8, input: *u8, length: s64, output: *u8) {
    block: [ChaChaBlockBytes]u8
    defer Wipe.SecureWipe(block[:])
    offset: s64 = 0
    counter: u32 = 1
    while offset < length {
        ChaChaBlock(key, nonce, counter, *block[0])
        count: s64 = length - offset
        if count > ChaChaBlockBytes {
            count = ChaChaBlockBytes
        }
        index: s64 = 0
        while index < count {
            output[offset + index] = input[offset + index] ^ block[index]
            index += 1
        }
        offset += count
        counter += 1
    }
}

ChaChaMacKey :: (key: *u8, nonce: *u8, output: *u8) {
    block: [ChaChaBlockBytes]u8
    defer Wipe.SecureWipe(block[:])
    ChaChaBlock(key, nonce, 0, *block[0])
    index: s32 = 0
    while index < 32 {
        output[index] = block[index]
        index += 1
    }
}

#scope_export
ChaCha20Poly1305Seal :: (key: *u8, nonce: *u8,
    plain: *u8, plain_length: s64, aad: *u8, aad_length: s64,
    output: *u8, output_capacity: s64) -> s32 {
    if key == null || nonce == null || output == null ||
        !ChaChaLengthValid(plain_length) || aad_length < 0 ||
        (plain == null && plain_length > 0) ||
        (aad == null && aad_length > 0) ||
        output_capacity < ChaChaTagBytes ||
        plain_length > output_capacity - ChaChaTagBytes {
        return 0
    }
    mac_key: [32]u8
    tag: [ChaChaTagBytes]u8
    defer Wipe.SecureWipe(mac_key[:])
    ChaChaMacKey(key, nonce, *mac_key[0])
    if plain_length > 0 {
        ChaChaXor(key, nonce, plain, plain_length, output)
    }
    Poly1305AeadTag(*mac_key[0], aad, aad_length, output, plain_length, *tag[0])
    index: s32 = 0
    while index < ChaChaTagBytes {
        output[plain_length + cast(s64)index] = tag[index]
        index += 1
    }
    return 1
}

ChaCha20Poly1305Open :: (key: *u8, nonce: *u8,
    sealed: *u8, sealed_length: s64, aad: *u8, aad_length: s64,
    plain: *u8, plain_capacity: s64) -> s32 {
    if key == null || nonce == null || sealed == null ||
        sealed_length < ChaChaTagBytes ||
        !ChaChaLengthValid(sealed_length - ChaChaTagBytes) ||
        aad_length < 0 || (aad == null && aad_length > 0) ||
        plain_capacity < sealed_length - ChaChaTagBytes ||
        (plain == null && sealed_length > ChaChaTagBytes) {
        return 0
    }
    plain_length := sealed_length - ChaChaTagBytes
    mac_key: [32]u8
    tag: [ChaChaTagBytes]u8
    defer Wipe.SecureWipe(mac_key[:])
    ChaChaMacKey(key, nonce, *mac_key[0])
    Poly1305AeadTag(*mac_key[0], aad, aad_length, sealed, plain_length, *tag[0])
    difference: u8 = 0
    index: s32 = 0
    while index < ChaChaTagBytes {
        difference |= tag[index] ^ sealed[plain_length + cast(s64)index]
        index += 1
    }
    if difference != 0 {
        return 0
    }
    if plain_length > 0 {
        ChaChaXor(key, nonce, sealed, plain_length, plain)
    }
    return 1
}

HChaCha20 :: (key: *u8, nonce: *u8, output: *u8) {
    working: [16]u32
    defer Wipe.SecureWipePointer(cast(*u8)*working[0], size_of(type_of(working)))
    working[0] = 0x61707865
    working[1] = 0x3320646e
    working[2] = 0x79622d32
    working[3] = 0x6b206574
    index: s32 = 0
    while index < 8 {
        working[4 + index] = Load32LE(*key[index * 4])
        index += 1
    }
    index = 0
    while index < 4 {
        working[12 + index] = Load32LE(*nonce[index * 4])
        index += 1
    }
    round: s32 = 0
    while round < 10 {
        ChaChaQuarterRound(*working[0], 0, 4, 8, 12)
        ChaChaQuarterRound(*working[0], 1, 5, 9, 13)
        ChaChaQuarterRound(*working[0], 2, 6, 10, 14)
        ChaChaQuarterRound(*working[0], 3, 7, 11, 15)
        ChaChaQuarterRound(*working[0], 0, 5, 10, 15)
        ChaChaQuarterRound(*working[0], 1, 6, 11, 12)
        ChaChaQuarterRound(*working[0], 2, 7, 8, 13)
        ChaChaQuarterRound(*working[0], 3, 4, 9, 14)
        round += 1
    }
    index = 0
    while index < 4 {
        Store32LE(*output[index * 4], working[index])
        Store32LE(*output[16 + index * 4], working[12 + index])
        index += 1
    }
}

XChaCha20Poly1305Seal :: (key: *u8, nonce: *u8,
    plain: *u8, plain_length: s64, aad: *u8, aad_length: s64,
    output: *u8, output_capacity: s64) -> s32 {
    if key == null || nonce == null { return 0 }
    subkey: [32]u8
    short_nonce: [12]u8
    defer Wipe.SecureWipe(subkey[:])
    HChaCha20(key, nonce, *subkey[0])
    for index: 0..11 {
        short_nonce[index] = ifx index < 4 then cast(u8)0 else nonce[12 + index]
    }
    return ChaCha20Poly1305Seal(*subkey[0], *short_nonce[0], plain, plain_length,
        aad, aad_length, output, output_capacity)
}

XChaCha20Poly1305Open :: (key: *u8, nonce: *u8,
    sealed: *u8, sealed_length: s64, aad: *u8, aad_length: s64,
    plain: *u8, plain_capacity: s64) -> s32 {
    if key == null || nonce == null { return 0 }
    subkey: [32]u8
    short_nonce: [12]u8
    defer Wipe.SecureWipe(subkey[:])
    HChaCha20(key, nonce, *subkey[0])
    for index: 0..11 {
        short_nonce[index] = ifx index < 4 then cast(u8)0 else nonce[12 + index]
    }
    return ChaCha20Poly1305Open(*subkey[0], *short_nonce[0], sealed, sealed_length,
        aad, aad_length, plain, plain_capacity)
}

// Slice wrappers for ergonomic Ziran callers.
ChaCha20Poly1305SealBytes :: (key: []u8, nonce: []u8, plain: []u8, aad: []u8, output: []u8) -> s64 {
    if key.count != 32 || nonce.count != 12 || output.count < plain.count + 16 { return -1 }
    plain_ptr := ifx plain.count > 0 then *plain[0] else null
    aad_ptr := ifx aad.count > 0 then *aad[0] else null
    if ChaCha20Poly1305Seal(*key[0], *nonce[0], plain_ptr, plain.count, aad_ptr, aad.count,
        *output[0], output.count) != 1 {
        Wipe.SecureWipe(output)
        return -1
    }
    return plain.count + 16
}

ChaCha20Poly1305OpenBytes :: (key: []u8, nonce: []u8, sealed: []u8, aad: []u8, output: []u8) -> s64 {
    if key.count != 32 || nonce.count != 12 || sealed.count < 16 || output.count < sealed.count - 16 { return -1 }
    aad_ptr := ifx aad.count > 0 then *aad[0] else null
    out_ptr := ifx sealed.count > 16 then *output[0] else null
    if ChaCha20Poly1305Open(*key[0], *nonce[0], *sealed[0], sealed.count, aad_ptr, aad.count,
        out_ptr, output.count) != 1 {
        Wipe.SecureWipe(output)
        return -1
    }
    return sealed.count - 16
}

XChaCha20Poly1305SealBytes :: (key: []u8, nonce: []u8, plain: []u8, aad: []u8, output: []u8) -> s64 {
    if key.count != 32 || nonce.count != 24 || output.count < plain.count + 16 { return -1 }
    plain_ptr := ifx plain.count > 0 then *plain[0] else null
    aad_ptr := ifx aad.count > 0 then *aad[0] else null
    if XChaCha20Poly1305Seal(*key[0], *nonce[0], plain_ptr, plain.count, aad_ptr, aad.count,
        *output[0], output.count) != 1 {
        Wipe.SecureWipe(output)
        return -1
    }
    return plain.count + 16
}

XChaCha20Poly1305OpenBytes :: (key: []u8, nonce: []u8, sealed: []u8, aad: []u8, output: []u8) -> s64 {
    if key.count != 32 || nonce.count != 24 || sealed.count < 16 || output.count < sealed.count - 16 { return -1 }
    aad_ptr := ifx aad.count > 0 then *aad[0] else null
    out_ptr := ifx sealed.count > 16 then *output[0] else null
    if XChaCha20Poly1305Open(*key[0], *nonce[0], *sealed[0], sealed.count, aad_ptr, aad.count,
        out_ptr, output.count) != 1 {
        Wipe.SecureWipe(output)
        return -1
    }
    return sealed.count - 16
}
