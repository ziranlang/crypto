// SHA-1 is used only where Telegram's legacy key-exchange format requires it.
Context :: struct { state: [5]u32; block: [64]u8; used: s32; length: u64; }
Rotate :: (x: u32, n: u32) -> u32 { return (x << n) | (x >> (cast(u32)32 - n)) }
Transform :: (c: *Context) {
    w: [80]u32
    for i: 0..15 { w[i] = (cast(u32)c.block[i*4] << cast(u32)24) | (cast(u32)c.block[i*4+1] << cast(u32)16) | (cast(u32)c.block[i*4+2] << cast(u32)8) | cast(u32)c.block[i*4+3] }
    for i: 16..79 { w[i] = Rotate(w[i-3] ^ w[i-8] ^ w[i-14] ^ w[i-16], 1) }
    a := c.state[0]; b := c.state[1]; d := c.state[2]; e := c.state[3]; f := c.state[4]
    for i: 0..79 {
        v: u32; k: u32
        if i < 20 { v = (b & d) | ((~b) & e); k = 0x5a827999 }
        else if i < 40 { v = b ^ d ^ e; k = 0x6ed9eba1 }
        else if i < 60 { v = (b & d) | (b & e) | (d & e); k = 0x8f1bbcdc }
        else { v = b ^ d ^ e; k = 0xca62c1d6 }
        t := Rotate(a, 5) + v + f + k + w[i]
        f = e; e = d; d = Rotate(b, 30); b = a; a = t
    }
    c.state[0] += a; c.state[1] += b; c.state[2] += d; c.state[3] += e; c.state[4] += f
}
Start :: (c: *Context) { c.state = .{0x67452301,0xefcdab89,0x98badcfe,0x10325476,0xc3d2e1f0}; c.used = 0; c.length = 0 }
Update :: (c: *Context, bytes: []u8) {
    for i: 0..cast(s32)bytes.count-1 { c.block[c.used] = bytes[i]; c.used += 1; c.length += cast(u64)1; if c.used == 64 { Transform(c); c.used = 0 } }
}
Finish :: (c: *Context, output: []u8) -> bool {
    if output.count != 20 { return false }
    bits := c.length * cast(u64)8; c.block[c.used] = 128; c.used += 1
    if c.used > 56 { while c.used < 64 { c.block[c.used] = 0; c.used += 1 }; Transform(c); c.used = 0 }
    while c.used < 56 { c.block[c.used] = 0; c.used += 1 }
    for i: 0..7 { c.block[63-i] = cast(u8)(bits >> cast(u64)(8*i)) }
    Transform(c)
    for i: 0..19 { output[i] = cast(u8)(c.state[i/4] >> cast(u32)(24-8*(i%4))) }; return true
}
Sha1 :: (bytes: []u8, output: []u8) -> bool { c: Context; Start(*c); Update(*c, bytes); return Finish(*c, output) }
