// The hashes portable bundles use, built and run as a bundle: SHA-256's
// string forms, SHA-1 and SHA-512 over slices.
Hash :: #import "sha256";
Sha1 :: #import "sha1";
Sha512 :: #import "sha512";

hex_text: [128]u8;

Hex :: (bytes: []u8) -> string {
    digits := "0123456789abcdef"
    text := hex_text[:]
    for index: 0..cast(s32)bytes.count - 1 {
        text[index * 2] = digits[cast(s64)(bytes[index] >> cast(u8)4)]
        text[index * 2 + 1] = digits[cast(s64)(bytes[index] & cast(u8)15)]
    }
    return TextView(hex_text[0:bytes.count * 2])
}

#program_export
Run :: () -> s32 {
    failed: s32 = 0
    digest := Hash.Sha256Of("abc")
    if Hex(digest[:]) != "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" { failed += 1 }
    mac := Hash.HmacSha256Of("Jefe", "what do ya want for nothing?")
    if Hex(mac[:]) != "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843" { failed += 1 }
    derived := Hash.Pbkdf2Sha256("password", "salt", 2)
    if Hex(derived[:]) != "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43" { failed += 1 }
    abc: [3]u8 = .[97, 98, 99]
    short: [20]u8
    if !Sha1.Sha1(abc[:], short[:]) || Hex(short[:]) != "a9993e364706816aba3e25717850c26c9cd0d89d" { failed += 1 }
    long: [64]u8
    if !Sha512.Sha512(abc[:], long[:]) || Hex(long[:]) != "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f" { failed += 1 }
    return failed
}
